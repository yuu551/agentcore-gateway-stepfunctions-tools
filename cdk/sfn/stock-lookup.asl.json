{
  "Comment": "在庫照会ワークフロー",
  "QueryLanguage": "JSONata",
  "StartAt": "GetStock",
  "States": {
    "GetStock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "${TABLE_NAME}",
        "Key": { "item": { "S": "{% $states.input.item %}" } }
      },
      "Output": "{% $exists($states.result.Item) ? {'item': $states.result.Item.item.S, 'stock': $number($states.result.Item.stock.N), 'unitPrice': $number($states.result.Item.unitPrice.N), 'dailySales': $number($states.result.Item.dailySales.N)} : {'item': $states.input.item, 'status': 'NOT_FOUND'} %}",
      "End": true
    }
  }
}
